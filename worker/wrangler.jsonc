// CheckLah Worker. Local development needs no Cloudflare credentials.
// database_id values are placeholders for local mode only; real IDs are filled in at the
// approved deployment step (docs/deployment-handoff.md). No cron trigger is configured.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checklah",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": false },
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "../web/dist", "binding": "ASSETS", "run_worker_first": true },
  "env": {
    "demo": {
      "name": "checklah-demo",
      "vars": { "MODE": "demo", "AUTH": "off", "ALLOW_LOOPBACK_NO_AUTH": "true", "REFRESH_ENABLED": "false" },
      "d1_databases": [{ "binding": "DB", "database_name": "checklah-demo", "database_id": "00000000-0000-4000-8000-00000000demo", "migrations_dir": "migrations" }]
    },
    "live": {
      "name": "checklah-live",
      "vars": { "MODE": "live", "AUTH": "off", "ALLOW_LOOPBACK_NO_AUTH": "true", "REFRESH_ENABLED": "false" },
      "d1_databases": [{ "binding": "DB", "database_name": "checklah-live", "database_id": "00000000-0000-4000-8000-00000000live", "migrations_dir": "migrations" }]
    }
  }
}
